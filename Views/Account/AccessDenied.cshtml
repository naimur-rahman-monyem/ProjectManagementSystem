@{
    ViewBag.Title = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="text-center py-5">
    <div class="display-1 text-danger mb-3"><i class="bi bi-shield-slash"></i></div>
    <h1 class="fw-bold text-dark">403 - Access Denied</h1>
    <p class="lead text-muted max-w-md mx-auto">You do not have the required permissions to access this page or resource.</p>
    <a href="@Url.Action("Index", "Dashboard")" class="btn btn-primary rounded-pill px-4 mt-3">
        <i class="bi bi-house me-1"></i> Return to Dashboard
    </a>
</div>
