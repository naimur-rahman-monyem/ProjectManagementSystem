@model ProjectManagementSystem.Models.ViewModels.ProjectMemberViewModel
@{
    ViewBag.Title = "Manage Team Members - " + Model.ProjectName;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-custom p-4 shadow-sm border-0 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <div>
                    <h4 class="fw-bold m-0"><i class="bi bi-people me-2 text-primary"></i>Team Members</h4>
                    <p class="text-muted small m-0">Project: <strong>@Model.ProjectName</strong></p>
                </div>
                <a href="@Url.Action("Details", "Projects", new { id = Model.ProjectId })" class="btn btn-outline-secondary btn-sm rounded-pill px-3">&larr; Back to Project</a>
            </div>

            <!-- Add Member Form -->
            @using (Html.BeginForm("AddMember", "Projects", FormMethod.Post, new { @class = "row g-3 align-items-end mb-4 bg-light p-3 rounded-3" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ProjectId)

                <div class="col-md-9">
                    @Html.LabelFor(m => m.SelectedUserId, new { @class = "form-label fw-semibold small text-secondary" })
                    @Html.DropDownListFor(m => m.SelectedUserId, Model.AvailableUsersList, "-- Select User to Add --", new { @class = "form-select" })
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100 rounded-3"><i class="bi bi-person-plus me-1"></i> Add Member</button>
                </div>
            }

            <!-- Current Members -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-secondary mb-0">
                    <i class="bi bi-people me-1"></i>
                    Current Team Members
                </h6>

                <span class="badge bg-primary-subtle text-primary">
                    @Model.CurrentMembers.Count Members
                </span>
            </div>

            @if (Model.CurrentMembers.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Member</th>
                                <th>Email</th>
                                <th>Assigned Date</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var member in Model.CurrentMembers)
                            {
                                var firstName = member.User != null ? member.User.FirstName : "";
                                var lastName = member.User != null ? member.User.LastName : "";
                                var email = member.User != null ? member.User.Email : "";
                                var fullName = (firstName + " " + lastName).Trim();

                                var initial = !string.IsNullOrEmpty(firstName)
                                    ? firstName.Substring(0, 1).ToUpper()
                                    : "U";

                                <tr>

                                    <!-- Member -->
                                    <td>
                                        <div class="d-flex align-items-center gap-2">

                                            <div class="avatar-icon bg-primary-subtle rounded-circle
                            text-primary fw-bold d-flex
                            align-items-center justify-content-center"
                                                 style="width:40px;height:40px;">

                                                @initial

                                            </div>

                                            <div>
                                                <div class="fw-semibold">
                                                    @fullName
                                                </div>

                                                <small class="text-muted">
                                                    Team Member
                                                </small>
                                            </div>

                                        </div>
                                    </td>

                                    <!-- Email -->
                                    <td>
                                        <span class="text-secondary">
                                            <i class="bi bi-envelope me-1"></i>
                                            @email
                                        </span>
                                    </td>

                                    <!-- Assigned Date -->
                                    <td>
                                        <span class="text-muted">
                                            <i class="bi bi-calendar3 me-1"></i>
                                            @member.JoinedDate.ToString("yyyy-MM-dd")
                                        </span>

                                        <br />

                                        <small class="text-muted">
                                            @member.JoinedDate.ToString("hh:mm tt")
                                        </small>
                                    </td>

                                    <!-- Action -->
                                    <td class="text-end">

                                        @using (Html.BeginForm(
                                            "RemoveMember",
                                            "Projects",
                                            new
                                            {
                                                projectMemberId = member.ProjectMemberId
                                            },
                                            FormMethod.Post,
                                            new
                                            {
                                                @class = "d-inline"
                                            }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                                    onclick="return confirm('Remove this user from the team?');">

                                                <i class="bi bi-person-dash me-1"></i>
                                                Remove

                                            </button>
                                        }

                                    </td>

                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">

                    <i class="bi bi-people fs-1 d-block mb-2"></i>

                    <div class="fw-semibold">
                        No team members assigned
                    </div>

                    <small>
                        Select a user above to add them to this project.
                    </small>

                </div>
            }
        </div>
    </div>
</div>
