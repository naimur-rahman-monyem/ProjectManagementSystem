@model IEnumerable<ProjectManagementSystem.Models.ViewModels.UserListViewModel>
@{
    ViewBag.Title = "User Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold m-0"><i class="bi bi-people me-2 text-primary"></i>System Users</h4>
        <p class="text-muted small m-0">Manage system user accounts, roles, and status</p>
    </div>
    <a href="@Url.Action("Create", "Users")" class="btn btn-primary rounded-pill px-4"><i class="bi bi-person-plus me-1"></i> Add New User</a>
</div>

<div class="card card-custom p-4 shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>User Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Department</th>
                    <th>Status</th>
                    <th>Created Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="fw-semibold">@user.FullName</td>
                        <td>@user.Email</td>
                        <td>
                            <span class="badge @(user.RoleName == "Admin" ? "bg-danger" : user.RoleName == "ProjectManager" ? "bg-primary" : "bg-success")">
                                @user.RoleName
                            </span>
                        </td>
                        <td><span class="text-secondary small">@user.DepartmentName</span></td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5">Inactive</span>
                            }
                        </td>
                        <td><small class="text-muted">@user.CreatedDate.ToString("yyyy-MM-dd")</small></td>
                        <td class="text-end">
                            <a href="@Url.Action("Edit", "Users", new { id = user.Id })" class="btn btn-light btn-sm text-primary rounded-circle me-1" title="Edit"><i class="bi bi-pencil"></i></a>
                            
                            @using (Html.BeginForm("ToggleStatus", "Users", new { id = user.Id }, FormMethod.Post, new { @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-light btn-sm @(user.IsActive ? "text-warning" : "text-success") rounded-circle" title="@(user.IsActive ? "Deactivate" : "Activate")">
                                    <i class="bi @(user.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
