@model IEnumerable<ProjectManagementSystem.Models.Notification>
@{
    ViewBag.Title = "Notifications Center";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card card-custom p-4 shadow-sm border-0">
            <h4 class="fw-bold mb-4 pb-2 border-bottom"><i class="bi bi-bell me-2 text-primary"></i>Notifications</h4>

            @if (Model.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var n in Model)
                    {
                        <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-start border-bottom @(!n.IsRead ? "bg-light bg-opacity-50 p-3 rounded-3 my-1" : "")">
                            <div class="d-flex align-items-start gap-3">
                                <div class="stat-icon bg-primary bg-opacity-10 text-primary mt-1" style="width: 40px; height: 40px; border-radius: 10px; font-size: 1.1rem;">
                                    <i class="bi bi-bell-fill"></i>
                                </div>
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <h6 class="fw-bold mb-0 text-dark">@n.Title</h6>
                                        @if (!n.IsRead)
                                        {
                                            <span class="badge bg-danger rounded-pill extra-small">New</span>
                                        }
                                    </div>
                                    <p class="text-secondary small mb-1">@n.Message</p>
                                    <small class="text-muted extra-small"><i class="bi bi-clock me-1"></i>@n.CreatedDate.ToString("g")</small>
                                </div>
                            </div>

                            @if (!n.IsRead)
                            {
                                using (Html.BeginForm("MarkAsRead", "Notifications", new { id = n.NotificationId }, FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill"><i class="bi bi-check2"></i> Mark Read</button>
                                }
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-bell-slash fs-1 opacity-50 d-block mb-2"></i>
                    You have no notifications.
                </div>
            }
        </div>
    </div>
</div>
