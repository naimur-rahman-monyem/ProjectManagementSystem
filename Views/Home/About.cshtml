@{
    ViewBag.Title = "About";
}

<main>

    <!-- Hero -->
    <section class="py-5">
        <div class="container">

            <div class="row align-items-center">

                <div class="col-lg-7">

                    <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill mb-3">
                        <i class="bi bi-kanban me-1"></i>
                        About Our System
                    </span>

                    <h1 class="display-5 fw-bold text-dark mb-3">
                        Project Management Made Simple
                    </h1>

                    <p class="lead text-muted mb-4">
                        Our Project Management System helps organizations plan,
                        organize, and monitor projects while keeping teams
                        connected and productive.
                    </p>

                    <p class="text-muted">
                        From creating projects and assigning team members to
                        managing tasks and tracking progress, everything is
                        organized in one centralized platform.
                    </p>

                </div>

                <div class="col-lg-5 mt-4 mt-lg-0">

                    <div class="card border-0 shadow-sm rounded-4 p-4">

                        <div class="text-center">

                            <div class="bg-primary-subtle text-primary rounded-circle
                                        d-inline-flex align-items-center justify-content-center mb-3"
                                 style="width:80px;height:80px;">
                                <i class="bi bi-kanban fs-1"></i>
                            </div>

                            <h4 class="fw-bold">
                                Project Management System
                            </h4>

                            <p class="text-muted mb-0">
                                Organize. Collaborate. Deliver.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </section>


    <!-- Features -->
    <section class="py-5 bg-light">

        <div class="container">

            <div class="text-center mb-5">

                <h2 class="fw-bold">
                    What Our System Provides
                </h2>

                <p class="text-muted">
                    Everything your team needs to manage projects efficiently.
                </p>

            </div>

            <div class="row g-4">

                <div class="col-md-4">

                    <div class="card border-0 shadow-sm rounded-4 h-100 p-4">

                        <div class="bg-primary-subtle text-primary rounded-3
                                    d-flex align-items-center justify-content-center mb-3"
                             style="width:55px;height:55px;">
                            <i class="bi bi-kanban fs-4"></i>
                        </div>

                        <h5 class="fw-bold">
                            Project Management
                        </h5>

                        <p class="text-muted mb-0">
                            Create projects, assign project managers,
                            define deadlines, and monitor overall progress.
                        </p>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="card border-0 shadow-sm rounded-4 h-100 p-4">

                        <div class="bg-success-subtle text-success rounded-3
                                    d-flex align-items-center justify-content-center mb-3"
                             style="width:55px;height:55px;">
                            <i class="bi bi-check2-square fs-4"></i>
                        </div>

                        <h5 class="fw-bold">
                            Task Management
                        </h5>

                        <p class="text-muted mb-0">
                            Create and assign tasks, set priorities,
                            track deadlines, and monitor completion.
                        </p>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="card border-0 shadow-sm rounded-4 h-100 p-4">

                        <div class="bg-info-subtle text-info rounded-3
                                    d-flex align-items-center justify-content-center mb-3"
                             style="width:55px;height:55px;">
                            <i class="bi bi-people fs-4"></i>
                        </div>

                        <h5 class="fw-bold">
                            Team Management
                        </h5>

                        <p class="text-muted mb-0">
                            Add team members to projects and clearly
                            organize responsibilities across the team.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- How It Works -->
    <section class="py-5">

        <div class="container">

            <div class="text-center mb-5">

                <h2 class="fw-bold">
                    How It Works
                </h2>

                <p class="text-muted">
                    A simple workflow for managing your projects.
                </p>

            </div>

            <div class="row g-4 text-center">

                <div class="col-md-3">

                    <div class="mb-3">
                        <div class="bg-primary text-white rounded-circle
                                    d-inline-flex align-items-center justify-content-center"
                             style="width:60px;height:60px;">
                            <span class="fw-bold fs-5">1</span>
                        </div>
                    </div>

                    <h5 class="fw-bold">
                        Create Project
                    </h5>

                    <p class="text-muted small">
                        Create a project and define its basic information,
                        manager, department, and timeline.
                    </p>

                </div>


                <div class="col-md-3">

                    <div class="mb-3">
                        <div class="bg-primary text-white rounded-circle
                                    d-inline-flex align-items-center justify-content-center"
                             style="width:60px;height:60px;">
                            <span class="fw-bold fs-5">2</span>
                        </div>
                    </div>

                    <h5 class="fw-bold">
                        Add Team
                    </h5>

                    <p class="text-muted small">
                        Add the users who will work on the project
                        and organize your project team.
                    </p>

                </div>


                <div class="col-md-3">

                    <div class="mb-3">
                        <div class="bg-primary text-white rounded-circle
                                    d-inline-flex align-items-center justify-content-center"
                             style="width:60px;height:60px;">
                            <span class="fw-bold fs-5">3</span>
                        </div>
                    </div>

                    <h5 class="fw-bold">
                        Assign Tasks
                    </h5>

                    <p class="text-muted small">
                        Assign tasks to team members with priorities,
                        deadlines, and progress tracking.
                    </p>

                </div>


                <div class="col-md-3">

                    <div class="mb-3">
                        <div class="bg-success text-white rounded-circle
                                    d-inline-flex align-items-center justify-content-center"
                             style="width:60px;height:60px;">
                            <span class="fw-bold fs-5">4</span>
                        </div>
                    </div>

                    <h5 class="fw-bold">
                        Track Progress
                    </h5>

                    <p class="text-muted small">
                        Monitor task completion and project progress
                        until the project is successfully delivered.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- CTA -->
    <section class="py-5 bg-light">

        <div class="container">

            <div class="card border-0 shadow-sm rounded-4 p-5 text-center">

                <h2 class="fw-bold mb-3">
                    Ready to Manage Your Projects?
                </h2>

                <p class="text-muted mb-4">
                    Start organizing your projects and teams today.
                </p>

                <div>

                    <a href="@Url.Action("Login", "Account")"
                       class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        Login
                    </a>

                    <a href="@Url.Action("Contact", "Home")"
                       class="btn btn-outline-secondary rounded-pill px-4 ms-2">
                        <i class="bi bi-envelope me-2"></i>
                        Contact Us
                    </a>

                </div>

            </div>

        </div>

    </section>

</main>