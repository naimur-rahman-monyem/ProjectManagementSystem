@model ProjectManagementSystem.Models.ViewModels.DashboardViewModel

@{
    ViewBag.Title = "Dashboard Overview";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ========================================================= -->
<!-- WELCOME BANNER -->
<!-- ========================================================= -->

<div class="card card-custom p-4 mb-4 border-0 text-white"
     style="background: linear-gradient(135deg, #1e1b4b, #4338ca); border-radius: 16px;">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

        <div>
            <h3 class="fw-bold mb-1">
                Welcome back, @Model.CurrentUserName!
            </h3>

            <p class="mb-0 text-white-50">
                Role:

                <span class="badge bg-white text-primary fw-semibold text-uppercase">
                    @Model.UserRole
                </span>

                <span class="mx-1">|</span>

                System Status:

                <span class="text-success fw-semibold">
                    Active
                </span>
            </p>
        </div>

        <div class="d-flex gap-2">

            @if (User.IsInRole("Admin"))
            {
                <a href="@Url.Action("Create", "Projects")"
                   class="btn btn-light btn-sm fw-semibold shadow-sm rounded-pill px-3">

                    <i class="bi bi-plus-circle me-1"></i>
                    New Project

                </a>

                <a href="@Url.Action("Create", "Users")"
                   class="btn btn-outline-light btn-sm fw-semibold rounded-pill px-3">

                    <i class="bi bi-person-plus me-1"></i>
                    Add User

                </a>
            }
            else if (User.IsInRole("ProjectManager"))
            {
                <a href="@Url.Action("Create", "Tasks")"
                   class="btn btn-light btn-sm fw-semibold shadow-sm rounded-pill px-3">

                    <i class="bi bi-plus-circle me-1"></i>
                    Create Task

                </a>
            }

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- OVERDUE TASK WARNING -->
<!-- ========================================================= -->

@if (Model.OverdueTasks > 0)
{
    <div class="alert alert-warning border-0 shadow-sm rounded-3 mb-4
                d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center gap-2">

            <i class="bi bi-exclamation-octagon-fill fs-4 text-warning"></i>

            <div>

                <strong class="text-dark">
                    Attention Required:
                </strong>

                You have

                <strong>
                    @Model.OverdueTasks overdue task(s)
                </strong>

                needing immediate action.

            </div>

        </div>

        <a href="@Url.Action("Index", "Tasks", new { overdueOnly = true })"
           class="btn btn-warning btn-sm fw-semibold rounded-pill px-3">

            View Overdue Tasks

        </a>

    </div>
}


<!-- ========================================================= -->
<!-- STAT CARDS -->
<!-- ========================================================= -->

<div class="row g-3 mb-4">

    <!-- TOTAL PROJECTS -->
    <div class="col-xl-3 col-md-6">

        <div class="card card-custom stat-card">

            <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                <i class="bi bi-folder-check"></i>
            </div>

            <div>

                <div class="text-muted small fw-medium">
                    Total Projects
                </div>

                <div class="fs-4 fw-bold text-dark">
                    @Model.TotalProjects
                </div>

                <span class="text-success small fw-semibold">
                    @Model.ActiveProjects Active
                </span>

            </div>

        </div>

    </div>


    <!-- TOTAL TASKS -->
    <div class="col-xl-3 col-md-6">

        <div class="card card-custom stat-card">

            <div class="stat-icon bg-info bg-opacity-10 text-info">
                <i class="bi bi-list-task"></i>
            </div>

            <div>

                <div class="text-muted small fw-medium">
                    Total Tasks
                </div>

                <div class="fs-4 fw-bold text-dark">
                    @Model.TotalTasks
                </div>

                <span class="text-info small fw-semibold">
                    @Model.InProgressTasks In Progress
                </span>

            </div>

        </div>

    </div>


    <!-- COMPLETED TASKS -->
    <div class="col-xl-3 col-md-6">

        <div class="card card-custom stat-card">

            <div class="stat-icon bg-success bg-opacity-10 text-success">
                <i class="bi bi-check-circle"></i>
            </div>

            <div>

                <div class="text-muted small fw-medium">
                    Completed Tasks
                </div>

                <div class="fs-4 fw-bold text-dark">
                    @Model.CompletedTasks
                </div>

                <span class="text-muted small">
                    @Model.PendingTasks Pending
                </span>

            </div>

        </div>

    </div>


    <!-- OVERDUE TASKS -->
    <div class="col-xl-3 col-md-6">

        <div class="card card-custom stat-card">

            <div class="stat-icon bg-danger bg-opacity-10 text-danger">
                <i class="bi bi-clock-history"></i>
            </div>

            <div>

                <div class="text-muted small fw-medium">
                    Overdue Tasks
                </div>

                <div class="fs-4 fw-bold text-danger">
                    @Model.OverdueTasks
                </div>

                <span class="text-danger small fw-semibold">
                    Requires Action
                </span>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- MAIN DASHBOARD -->
<!-- ========================================================= -->

<div class="row g-4">


    <!-- ===================================================== -->
    <!-- RECENT PROJECTS -->
    <!-- ===================================================== -->

    <div class="col-lg-7">

        <div class="card card-custom p-4 h-100">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="fw-bold m-0">

                    <i class="bi bi-folder me-2 text-primary"></i>

                    Recent Projects

                </h5>

                <a href="@Url.Action("Index", "Projects")"
                   class="btn btn-link btn-sm text-decoration-none">

                    View All Projects &rarr;

                </a>

            </div>


            @if (Model.RecentProjects != null &&
                 Model.RecentProjects.Count > 0)
            {

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Project Name
                                </th>

                                <th>
                                    Manager
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Progress
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var project in Model.RecentProjects)
                            {

                                /*
                                 * Get Department Name safely.
                                 * Do NOT use project.Department?.Name
                                 */

                                var departmentName = project.Department != null
                                    ? project.Department.Name
                                    : "General Department";


                                /*
                                 * Get Project Manager safely.
                                 */

                                var managerName = project.ProjectManager != null
                                    ? (project.ProjectManager.FirstName + " " +
                                       project.ProjectManager.LastName).Trim()
                                    : "Unassigned";


                                <tr>

                                    <!-- PROJECT -->
                                    <td>

                                        <a href="@Url.Action(
                                                    "Details",
                                                    "Projects",
                                                    new { id = project.ProjectId })"
                                           class="fw-semibold text-dark text-decoration-none">

                                            @project.Name

                                        </a>

                                        <div class="text-muted extra-small">

                                            @departmentName

                                        </div>

                                    </td>


                                    <!-- MANAGER -->
                                    <td>

                                        <small class="text-secondary">

                                            @managerName

                                        </small>

                                    </td>


                                    <!-- STATUS -->
                                    <td>

                                        @if (project.Status ==
                                            ProjectManagementSystem.Models.Enums.ProjectStatus.Active)
                                        {
                                            <span class="badge bg-success">
                                                @project.Status
                                            </span>
                                        }
                                        else if (project.Status ==
                                            ProjectManagementSystem.Models.Enums.ProjectStatus.Completed)
                                        {
                                            <span class="badge bg-primary">
                                                @project.Status
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @project.Status
                                            </span>
                                        }

                                    </td>


                                    <!-- PROGRESS -->
                                    <td style="width:140px;">

                                        <div class="d-flex align-items-center gap-2">

                                            <div class="progress flex-grow-1
                                                        progress-bar-custom bg-light">

                                                <div class="progress-bar bg-primary"
                                                     role="progressbar"
                                                     style="width:@project.ProgressPercentage%;">
                                                </div>

                                            </div>

                                            <small class="fw-semibold text-muted">

                                                @project.ProgressPercentage%

                                            </small>

                                        </div>

                                    </td>


                                    <!-- ACTION -->
                                    <td>

                                        <a href="@Url.Action(
                                                    "Details",
                                                    "Projects",
                                                    new { id = project.ProjectId })"
                                           class="btn btn-light btn-sm rounded-circle"
                                           title="View Details">

                                            <i class="bi bi-arrow-right-short fs-5"></i>

                                        </a>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <div class="text-center py-4 text-muted">

                    <i class="bi bi-folder-x fs-1 opacity-50 d-block mb-2"></i>

                    No projects found for display.

                </div>

            }

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- ASSIGNED TASKS -->
    <!-- ===================================================== -->

    <div class="col-lg-5">

        <div class="card card-custom p-4 mb-4">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="fw-bold m-0">

                    <i class="bi bi-card-checklist me-2 text-info"></i>

                    Assigned Tasks

                </h5>

                <a href="@Url.Action("Index", "Tasks")"
                   class="btn btn-link btn-sm text-decoration-none">

                    View All &rarr;

                </a>

            </div>


            @if (Model.AssignedTasks != null &&
                 Model.AssignedTasks.Count > 0)
            {

                <div class="list-group list-group-flush">

                    @foreach (var task in Model.AssignedTasks)
                    {

                        /*
                         * Safely get project name.
                         */

                        var taskProjectName = task.Project != null
                            ? task.Project.Name
                            : "No Project";


                        <a href="@Url.Action(
                                    "Details",
                                    "Tasks",
                                    new { id = task.TaskItemId })"
                           class="list-group-item list-group-item-action
                                  py-3 px-0 border-bottom">


                            <div class="d-flex justify-content-between
                                        align-items-start mb-1">

                                <span class="fw-semibold text-dark">

                                    @task.Title

                                </span>


                                <!-- PRIORITY -->

                                @if (task.Priority ==
                                    ProjectManagementSystem.Models.Enums.TaskPriority.Critical)
                                {
                                    <span class="badge bg-danger">
                                        @task.Priority
                                    </span>
                                }
                                else if (task.Priority ==
                                    ProjectManagementSystem.Models.Enums.TaskPriority.High)
                                {
                                    <span class="badge bg-warning text-dark">
                                        @task.Priority
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @task.Priority
                                    </span>
                                }

                            </div>


                            <div class="d-flex justify-content-between
                                        align-items-center extra-small text-muted">

                                <!-- PROJECT -->

                                <span>

                                    <i class="bi bi-folder me-1"></i>

                                    @taskProjectName

                                </span>


                                <!-- DUE DATE -->

                                @if (task.DueDate < DateTime.Now)
                                {
                                    <span class="text-danger fw-bold">

                                        <i class="bi bi-calendar-event me-1"></i>

                                        Due:
                                        @task.DueDate.ToString("MMM dd")

                                    </span>
                                }
                                else
                                {
                                    <span>

                                        <i class="bi bi-calendar-event me-1"></i>

                                        Due:
                                        @task.DueDate.ToString("MMM dd")

                                    </span>
                                }

                            </div>


                        </a>

                    }

                </div>

            }
            else
            {

                <div class="text-center py-4 text-muted">

                    <i class="bi bi-check2-circle fs-1 opacity-50 d-block mb-2"></i>

                    No active assigned tasks.

                </div>

            }

        </div>

    </div>

</div>