@model IEnumerable<ProjectManagementSystem.Models.Department>
@{
    ViewBag.Title = "Departments Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold m-0"><i class="bi bi-building me-2 text-primary"></i>Departments & Teams</h4>
        <p class="text-muted small m-0">Manage organizational departments and team assignments</p>
    </div>
    <a href="@Url.Action("Create", "Departments")" class="btn btn-primary rounded-pill px-4"><i class="bi bi-plus-circle me-1"></i> Add Department</a>
</div>

<div class="row g-4">
    @foreach (var dept in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card card-custom p-4 h-100 position-relative">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h5 class="fw-bold text-dark m-0">@dept.Name</h5>
                    <span class="badge @(dept.IsActive ? "bg-success" : "bg-secondary")">@(dept.IsActive ? "Active" : "Inactive")</span>
                </div>
                <p class="text-muted small flex-grow-1">@(string.IsNullOrEmpty(dept.Description) ? "No description available." : dept.Description)</p>
                
                <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-2 text-secondary small">
                    <span><i class="bi bi-people me-1"></i>@(dept.Users != null ? dept.Users.Count : 0) Members</span>
                    <span><i class="bi bi-folder me-1"></i>@(dept.Projects != null ? dept.Projects.Count : 0) Projects</span>
                </div>

                <div class="mt-3 text-end">
                    <a href="@Url.Action("Edit", "Departments", new { id = dept.DepartmentId })" class="btn btn-light btn-sm rounded-pill px-3"><i class="bi bi-pencil me-1"></i> Edit</a>
                </div>
            </div>
        </div>
    }
</div>
