@model ProjectManagementSystem.Models.ViewModels.TaskFormViewModel
@{
    ViewBag.Title = "Create Task";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-custom p-4 shadow-sm border-0">
            <h4 class="fw-bold mb-4 pb-2 border-bottom"><i class="bi bi-plus-circle me-2 text-primary"></i>Create New Task</h4>

            @using (Html.BeginForm("Create", "Tasks", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <div class="row g-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.ProjectId, new { @class = "form-label fw-semibold" })
                        @Html.DropDownListFor(m => m.ProjectId, Model.ProjectList, "-- Select Project --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.ProjectId, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.AssignedToUserId, new { @class = "form-label fw-semibold" })
                        @Html.DropDownListFor(m => m.AssignedToUserId, Model.AssigneeList, "-- Select Assignee --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.AssignedToUserId, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-12">
                        @Html.LabelFor(m => m.Title, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "Task Title" })
                        @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-12">
                        @Html.LabelFor(m => m.Description, new { @class = "form-label fw-semibold" })
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 4, placeholder = "Task requirements and acceptance criteria..." })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(m => m.Priority, new { @class = "form-label fw-semibold" })
                        @Html.EnumDropDownListFor(m => m.Priority, new { @class = "form-select" })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(m => m.Status, new { @class = "form-label fw-semibold" })
                        @Html.EnumDropDownListFor(m => m.Status, new { @class = "form-select" })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(m => m.DueDate, new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.DueDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.DueDate, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-12 mt-4 d-flex justify-content-between">
                        <a href="@Url.Action("Index", "Tasks")" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="bi bi-check-lg me-1"></i> Create Task</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
